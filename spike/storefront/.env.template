# ==============================================================================
#  Find Any Jersey — storefront environment
# ==============================================================================
#
#  Copy to .env.local. Everything prefixed NEXT_PUBLIC_ is compiled into the
#  browser bundle and is readable by anyone who opens the site — so nothing here
#  is a secret, and nothing secret may be added with that prefix.
#
#  That includes NEXT_PUBLIC_MEDUSA_PK: a publishable key is a sales-channel
#  selector, not a credential. The store API is protected by requiring one, not
#  by keeping it hidden.
# ==============================================================================


# ------------------------------------------------------------------ wiring
# Where the storefront calls the backend, and the key that selects the channel.
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PK=

# The region used before a shopper picks one. All five regions are USD.
NEXT_PUBLIC_REGION_ID=

# The canonical origin. Everything that has to agree on one absolute URL reads
# this — sitemap.xml, robots.txt, canonical links, JSON-LD and the CSP. Never
# derived from the Host header, which disagrees with itself the moment the site
# is reachable on a preview URL and its real domain at once.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing is opt-in per environment and defaults to no. A staging copy that
# quietly invites crawlers competes with the real store for its own keywords,
# and the failure is silent for weeks.
NEXT_PUBLIC_ALLOW_INDEXING=false


# ------------------------------------------------------------------ payments
# Stripe's publishable key. The card fields are an iframe served from our origin
# (Medusa 2.18 is PaymentIntents + Elements, not Checkout Sessions), which is
# what puts this checkout in PCI SAQ A-EP rather than SAQ A.
NEXT_PUBLIC_STRIPE_PK=


# ------------------------------------------------------------------ trader identity
# Consumer law requires the trader to be identifiable — FTC guidance and the EU
# UCPD both. The policy pages and the footer read these and render every unset
# field as a labelled gap with the reason it is required, rather than omitting a
# required disclosure or inventing a value.
#
# The trading entity is not the brand: the storefront trades as Find Any Jersey
# and the trader is Crux Christi. Both are lawful; the *trader* is the one the
# law wants named.
NEXT_PUBLIC_LEGAL_NAME=Crux Christi
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=

# GDPR Art. 15–22 and the US state privacy laws all require a request channel.
NEXT_PUBLIC_PRIVACY_EMAIL=


# ------------------------------------------------------------------ EU gates
# These three block EU orders outright rather than being a general compliance
# gap, which is why they are their own group. While any is empty the region
# picker refuses EU destinations and names the missing appointment.
#
#   Art. 27 representative  — required to sell into the EU from the US
#   GPSR responsible person — without one, apparel cannot lawfully be placed
#                             on the EU market at all
#   IOSS number             — import VAT on EU B2C consignments
NEXT_PUBLIC_EU_REPRESENTATIVE=
NEXT_PUBLIC_GPSR_RESPONSIBLE_PERSON=
NEXT_PUBLIC_IOSS_NUMBER=


# ------------------------------------------------------------------ analytics
# Consent-gated: nothing loads before a positive choice, and nothing loads at all
# under Global Privacy Control. Setting the key also adds the host to the CSP
# allow-list, so an unset key is a smaller CSP as well as no tracking.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=


# ------------------------------------------------------------------ personalisation
# Server-side only — no NEXT_PUBLIC_ prefix, so it stays out of the bundle. The
# add-on product whose variants price name / number / bundle / patch.
PERSONALISATION_PRODUCT_ID=

# ── Internal request signing ──────────────────────────────────────────
# Must match the backend's INTERNAL_API_SECRET. Server-side only — never
# NEXT_PUBLIC_, or every visitor can claim any IP and evade the backend's
# rate limits. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=
