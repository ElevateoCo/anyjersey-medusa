# Copy to .env.deploy and fill in what you have. Everything here is a placeholder.
#
#   docker compose --env-file .env.deploy up --build

# --- required, no default ---
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# --- database (compose creates it) ---
DB_USER=aj
DB_PASSWORD=aj_dev
DB_NAME=aj_store
DB_PORT=5433

# --- storefront build-time (inlined into the bundle) ---
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PK=
NEXT_PUBLIC_REGION_ID=
NEXT_PUBLIC_STRIPE_PK=

# --- critical in production: the backend refuses to boot without these ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=
RESEND_API_KEY=
RESEND_FROM=orders@findanyjersey.example
SHIPPO_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- optional ---
SENTRY_DSN=
TYPESENSE_HOST=
TYPESENSE_API_KEY=
POSTHOG_API_KEY=
RESEND_REDIRECT_TO=
# db (default) keeps image bytes in Postgres; r2 moves them to object storage
MEDIA_BACKEND=db

# ==============================================================================
#  Added by the environment audit.
#
#  docker-compose passes these through to both services, so this file is the
#  union of backend and storefront configuration rather than either one. The
#  per-service templates — backend/.env.template and storefront/.env.template —
#  document what each variable does and which of them block a production boot.
# ==============================================================================

# ---- backend, still required in production ---------------------------------
STOREFRONT_URL=
ADMIN_DISABLED=false
GIT_SHA=
# Empty = RBAC on in production. Seed roles BEFORE the first production boot:
#   npx medusa exec ./src/scripts/seed-rbac.ts
MEDUSA_FF_RBAC=

# ---- tax ---------------------------------------------------------------------
US_NEXUS_STATES=
US_HOME_STATE=

# ---- email -------------------------------------------------------------------
RESEND_REPLY_TO=

# ---- shipping: a label cannot be bought without a complete ship-from ----------
SHIP_FROM_NAME=
SHIP_FROM_STREET=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
ITEM_WEIGHT_GRAMS=200
CUSTOMS_HS_CODE=
CUSTOMS_ORIGIN_COUNTRY=

# ---- media -------------------------------------------------------------------
R2_PUBLIC_BASE=

# ---- personalisation ---------------------------------------------------------
PERSONALISATION_PRODUCT_ID=

# ---- observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=findanyjersey-backend
OMNISEND_API_KEY=

# ---- storefront: compiled into the browser bundle, so never secret -----------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_LEGAL_NAME=Crux Christi
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Each of these three blocks EU orders outright while it is empty.
NEXT_PUBLIC_EU_REPRESENTATIVE=
NEXT_PUBLIC_GPSR_RESPONSIBLE_PERSON=
NEXT_PUBLIC_IOSS_NUMBER=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ---- privacy -----------------------------------------------------------------
# Nightly retention job. Reports only until this is true.
PRIVACY_RETENTION_APPLY=false

# ---- admin links in operator notification emails -----------------------------
MEDUSA_ADMIN_URL=

# ---- commercial email --------------------------------------------------------
# CAN-SPAM requires a postal address on commercial email. Cart recovery refuses
# to send without it. Keep identical to NEXT_PUBLIC_LEGAL_ADDRESS.
SHOP_POSTAL_ADDRESS=
UNSUBSCRIBE_SECRET=

# ---- proxy -------------------------------------------------------------------
# "true" behind a load balancer that rewrites x-forwarded-for, "false" if exposed
# directly. Blocks a production boot when unset — the wrong default fails silently.
TRUST_PROXY=true
