# ==============================================================================
#  Find Any Jersey — backend environment
# ==============================================================================
#
#  Copy to .env and fill in what you have. Every variable the code reads is
#  listed here, including the ones with sane defaults, so that "is this
#  configurable?" is answerable from one file rather than by grepping.
#
#  The rule the application follows, from src/integrations.ts:
#
#    outside production  a missing key degrades visibly — the feature logs what
#                        it would have done and carries on. Nothing no-ops
#                        silently.
#    in production       assertConfigured() throws at boot for anything marked
#                        BLOCKS PRODUCTION below. A silently disabled
#                        integration is worse than a container that will not
#                        start.
#
#  Verify what is set and what is missing at /admin/integrations, or by starting
#  the server and reading the warning it prints.
# ==============================================================================


# ------------------------------------------------------------------ core
# BLOCKS PRODUCTION. No defaults for the secrets: `supersecret` is the fallback
# in medusa-config.ts and it must never survive into a deployment.
DATABASE_URL=postgres://aj:aj_dev@localhost:5433/aj_store
JWT_SECRET=
COOKIE_SECRET=

# Where the browser is allowed to call the API from. Comma-separated.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000

# Used in transactional email links. Without it, emails point nowhere useful.
STOREFRONT_URL=http://localhost:3000

# BLOCKS PRODUCTION. Not optional infrastructure: without it Medusa installs the
# local event bus, workflow engine, cache and lock provider, jobs run in-process,
# and a restart drops queued work — including the confirmation email for an order
# that has already been paid for.
REDIS_URL=redis://localhost:6380

# Medusa process role: shared runs the API and background jobs in one process.
# Production can split this into server and worker services using the same image.
MEDUSA_WORKER_MODE=shared

# Skip building the admin dashboard into the image. Not a feature flag, a memory
# one — the Vite build needs ~6 GB and is OOM-killed in a smaller builder.
ADMIN_DISABLED=false

# Stamped into /health/ready so a rollback can tell which build is answering.
GIT_SHA=


# ------------------------------------------------------------------ payments
# BLOCKS PRODUCTION.
#
# STRIPE_WEBHOOK_SECRET is enforced separately and earlier, in medusa-config.ts:
# with it empty the webhook endpoint returns 200 to unsigned and forged payloads.
# Measured, not assumed. Run `stripe listen` and paste the whsec_… value.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=


# ------------------------------------------------------------------ tax
# BLOCKS PRODUCTION. Stripe Tax bills 0.5% of volume, so it stays off until it is
# switched on deliberately. Off means "no tax calculated", not "no tax owed".
STRIPE_TAX_ENABLED=false

# Economic nexus after Wayfair: typically $100k or 200 transactions into a state.
# Add states as thresholds are crossed. Comma-separated two-letter codes.
US_NEXUS_STATES=
US_HOME_STATE=

# Stripe's tax code for apparel. Leave empty to use the module's default.
STRIPE_TAX_CODE_APPAREL=


# ------------------------------------------------------------------ email
# BLOCKS PRODUCTION. Without it the provider renders and logs instead of sending,
# which means order confirmations do not exist.
RESEND_API_KEY=
RESEND_FROM=orders@example.invalid
RESEND_REPLY_TO=
# Send every email to this address instead of the real recipient. For staging.
RESEND_REDIRECT_TO=


# ------------------------------------------------------------------ shipping
# BLOCKS PRODUCTION. Rating is live off our own rate card and needs no account;
# only labels, tracking and customs documents need the key.
SHIPPO_API_KEY=

# Required on every label. A label cannot be bought without a complete ship-from.
SHIP_FROM_NAME=
SHIP_FROM_STREET=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=

# Per-item weight used to build a shipment. Grams.
ITEM_WEIGHT_GRAMS=200

# Customs declarations on cross-border parcels. Both are supplier inputs that are
# still outstanding — see the regulatory block in jersey_detail.
CUSTOMS_HS_CODE=
CUSTOMS_ORIGIN_COUNTRY=


# ------------------------------------------------------------------ media
# postgres (default) keeps WebP originals in the media_asset table — about 410 MB
# for the whole catalogue, content-addressed and served immutable. r2 moves them
# to object storage, and then the four R2_ keys BLOCK PRODUCTION.
#
# The number that should decide it is restore time, which nobody has measured:
# the images ride along in every base backup.
MEDIA_BACKEND=postgres

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public origin, for putting a CDN in front of the media route.
R2_PUBLIC_BASE=

# Ingest and upload parameters. The defaults are measured: WebP q78 capped at
# 1400px is ~21% of the raw archive.
MEDIA_MAX_WIDTH=1400
MEDIA_QUALITY=78
MEDIA_MAX_UPLOAD_BYTES=15728640


# ------------------------------------------------------------------ access control
# Role-based access control. Defaults to ON in production and OFF everywhere else
# (medusa-config.ts); this variable overrides that in either direction, which is
# how you rehearse enforcement locally and how you turn it off in an emergency.
#
# Enabling it without seeding roles locks everybody out of the admin: the check
# refuses a user with no roles before it consults a single policy. Run
# `npx medusa exec ./src/scripts/seed-rbac.ts` first. /health/ready refuses to
# report ready while RBAC is on and nobody holds the *:* policy.
MEDUSA_FF_RBAC=


# ------------------------------------------------------------------ personalisation
# The add-on product whose variants price name / number / bundle / patch.
PERSONALISATION_PRODUCT_ID=

# Which patches a league offers, comma-separated, one variable per league:
#   PATCHES_NFL=Super Bowl LVIII,Pro Bowl
#   PATCHES_SOCCER=Champions League
# The patch tier is built and offers nothing until at least one is set.
# PATCHES_NFL=


# ------------------------------------------------------------------ observability
# Optional. Nothing is watched until SENTRY_DSN is set.
SENTRY_DSN=

# Optional tracing. The OpenTelemetry packages are NOT dependencies of Medusa and
# are absent from the production image unless installed — instrumentation.ts lists
# them. Setting this without them logs a warning and carries on.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=findanyjersey-backend


# ------------------------------------------------------------------ optional services
# None of these block a boot. Each is visible at /admin/integrations.

# Product search and native facet counts. Falls back to SQL ILIKE, which now has
# a trigram index behind it.
TYPESENSE_HOST=
TYPESENSE_API_KEY=

# Funnel and conversion. Revenue reporting is in-admin.
POSTHOG_API_KEY=
POSTHOG_HOST=

# Marketing email beyond the built-in flows. Subscribers are collected regardless,
# so the list exists whenever a provider is chosen.
OMNISEND_API_KEY=


# ==============================================================================
#  Not configuration — arguments to `medusa exec` scripts, listed so they are
#  discoverable rather than buried:
#
#    APPLY=1                 make an otherwise dry-run script write
#    WIDTH= QUALITY=         ingest-media.ts image parameters
#    REVIEWS_JSON=           import-reviews.ts source file
#    ORDERS= ABANDONED=      seed-orders.ts volumes
#    CODE= PERCENT=          seed-promotion.ts
#    ROLE= USER_EMAIL=       seed-rbac.ts assignment
#    OWNER_EMAIL=            seed-rbac.ts, shorthand for ROLE=owner
#    DEBUG_MEDIA=1           verbose media ingest logging
# ==============================================================================

# ---- privacy ----------------------------------------------------------
# The nightly retention job reports what is past its period and does nothing
# unless this is true. Storage limitation is GDPR Art. 5(1)(e); the periods
# themselves live in src/privacy.ts and are published on the policy page.
#
# Deliberately opt-in: the first run against a real database is the one that
# removes two years of history in a transaction nobody watched.
PRIVACY_RETENTION_APPLY=false

# ---- admin links in notifications ------------------------------------
# Where the "open in admin" buttons in operator notification emails point.
# Without it the emails still send and simply carry no link — the same
# degradation as everything else here.
MEDUSA_ADMIN_URL=http://localhost:9000

# ---- commercial email -------------------------------------------------
# The trader's registered postal address, as one line.
#
# Required on commercial email by CAN-SPAM, and the cart-recovery send —
# the only commercial message this shop sends — refuses to go out without
# it. Keep it identical to NEXT_PUBLIC_LEGAL_ADDRESS on the storefront;
# both are still outstanding, and the policy pages show it as such.
SHOP_POSTAL_ADDRESS=

# Signs unsubscribe links. Falls back to COOKIE_SECRET, which is fine —
# set this only if you want unsubscribe links to survive a cookie-secret
# rotation.
UNSUBSCRIBE_SECRET=

# ---- proxy ------------------------------------------------------------
# Is there a proxy in front of this app that overwrites x-forwarded-for?
#
# "true"  — behind a load balancer or CDN that rewrites the header. Rate
#           limits key off the client IP it reports.
# "false" — exposed directly. The header is ignored entirely, because a
#           forged one would give every request its own bucket and void
#           every rate limit silently.
#
# Blocks a production boot when unset. Either answer is fine; not
# answering is not, because the wrong default fails invisibly.
TRUST_PROXY=false

# ── Internal request signing ──────────────────────────────────────────
# The other half of the proxy question, and the more consequential half.
#
# Almost all of the storefront's backend traffic is made server-side —
# every cart mutation, the whole of checkout, and every auth call, because
# the session token is httpOnly and never reaches the browser. Those all
# arrive from one address, so a per-IP limit on login or cart completion
# would be a cap on the *shop* rather than on an attacker.
#
# This secret lets the storefront say whose request it is: it sends the
# customer's address in x-client-ip and this value in x-internal-secret,
# and only then is the address believed. x-forwarded-for cannot do it — a
# proxy in front of the backend overwrites that header, which is exactly
# what makes it trustworthy there.
#
# The storefront needs the SAME value, server-side only (no NEXT_PUBLIC_
# prefix — in the browser it would let any visitor claim any address).
# Generate with: openssl rand -hex 32
#
# Blocks a production boot when unset, because without it the limits on
# login, registration and checkout collapse onto one bucket.
INTERNAL_API_SECRET=
