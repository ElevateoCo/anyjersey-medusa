# Integration tests get their own database. medusaIntegrationTestRunner creates and drops
# one per run, so nothing here may point at the development database.
#
# The runner reads DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD — *not* DATABASE_URL — to
# create that database. Setting only DATABASE_URL made it connect to localhost:5432,
# where nothing is listening, and fail with a bare AggregateError.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=aj
DB_PASSWORD=aj_dev
DATABASE_URL=postgres://aj:aj_dev@localhost:5433/aj_store_test
REDIS_URL=redis://localhost:6380
JWT_SECRET=test
COOKIE_SECRET=test
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000
# Deliberately empty: the tests assert the degraded paths too.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=test@example.invalid

# Set so the forwarded-identity path in src/rate-limit.ts is exercised rather than skipped.
# The integration suite asserts both: a request with the secret is attributed to the address
# it names, and one without it is not.
INTERNAL_API_SECRET=test-internal-secret
